{
	// Base config from https://github.com/decksters-lab/fastfetch
	// and https://github.com/harilvfs/fastfetch/tree/old-days
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"display": {
		"separator": " ",
		"key": {
			"width": 16,
		},
	},
	"modules": [
		{
			"type": "custom",
			"format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐",
		},
		{ "type": "host", "key": "{2}    PC", "keyColor": "blue" },
		{ "type": "cpu", "key": "├─{2}  CPU", "keyColor": "blue" },
		{ "type": "gpu", "key": "├─{2}  GPU", "keyColor": "blue" },
		{ "type": "memory", "key": "├─{2}  RAM", "keyColor": "cyan" },
		{
			"type": "disk",
			"key": "├─{4}  {3}",
			"keyColor": "cyan",
		},
		{
			"type": "display",
			"key": "└─{4}  {2}",
			"keyColor": "green",
		},
		{
			"type": "custom",
			"format": "\u001b[90m└────────────────────────────────────────────────────┘",
		},
		{
			"type": "custom",
			"format": "\u001b[90m┌──────────────────────Software──────────────────────┐",
		},
		{
			"type": "os",
			"key": "{3}    {1}",
			"keyColor": "yellow",
			"format": "{2}",
		},
		{ "type": "kernel", "key": "├─{2}  Kernel", "keyColor": "yellow" },
		{ "type": "packages", "key": "├─{2}  Packages", "keyColor": "yellow" },
		{ "type": "de", "key": "├─{2}  DE", "keyColor": "red" },
		{ "type": "wm", "key": "├─{2}  WM", "keyColor": "red", "format": "{2}" },
		{
			"type": "command",
			"key": "├─󰞷  Shell",
			"keyColor": "red",
			"text": "echo $SHELL | awk -F/ '{print $NF}'",
		},
		{ "type": "terminal", "key": "├─󰆍  Terminal", "keyColor": "magenta" },
		{
			"type": "theme",
			"key": "├─󰏘  Theme",
			"keyColor": "magenta",
			"format": "{2}",
		},
		{ "type": "icons", "key": "└─{2}  Icons", "keyColor": "magenta" },
		{
			"type": "custom",
			"format": "\u001b[90m└────────────────────────────────────────────────────┘",
		},
		{
			"type": "custom",
			"format": "\u001b[90m                         Misc                         ",
		},
		{
			"type": "command",
			"key": "    OS Age",
			"keyColor": "white",
			"text": "echo \"$(($(($(date +%s) - $(stat -c %W /))) / 86400)) days \u001b[9;31m\u001b[0m\"",
		},
		{ "type": "uptime", "key": "  󰅐  Uptime", "keyColor": "white" },
		{
			"type": "command",
			"key": "  󰠖  Fortune",
			"keyColor": "white",
			"text": "echo $(fortune -s)",
		},
		"break",
		{ "type": "colors", "paddingLeft": 15 },
		"break",
	],
}
